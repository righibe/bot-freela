# ══════════════════════════════════════════════════════
#  Bot Freeela — Configuração de ambiente
#  Copie este arquivo para .env e preencha os valores.
# ══════════════════════════════════════════════════════

# Token do bot Discord (https://discord.com/developers/applications)
DISCORD_TOKEN=seu_token_aqui

# (Opcional) ID do servidor para sincronizar slash commands mais rápido
GUILD_ID=

# ══════════════════════════════════════════════════════
#  Pagamentos — AbacatePay (https://app.abacatepay.com)
# ══════════════════════════════════════════════════════
# Chave da API. Use uma chave de DESENVOLVIMENTO para testar (permite
# simular pagamentos sem dinheiro real). Sem essa chave, o bot funciona
# normalmente, mas a conclusão de projetos volta a ser manual (sem PIX).
ABACATEPAY_API_KEY=

# Secret do webhook (painel AbacatePay -> Integrações -> Webhooks).
# Opcional: o bot também confirma pagamentos por polling automático.
# URL do webhook: https://SEU_DOMINIO/webhooks/abacatepay
ABACATEPAY_WEBHOOK_SECRET=

# Percentual retido pela plataforma em cada projeto (padrão: 15)
TAXA_PLATAFORMA_PERCENT=15

# Validade do QR Code PIX em segundos (padrão: 3600 = 1 hora)
PIX_EXPIRACAO_SEGUNDOS=3600
